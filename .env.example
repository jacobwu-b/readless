# Every env var the app reads MUST appear here.
# When you add or remove an env var in code, update this file in the same PR.
# Values here are placeholders — never commit real secrets.

# --- Runtime ---
NODE_ENV=development

# --- Anthropic (book brief generation) ---
ANTHROPIC_API_KEY=

# --- Vercel KV (brief + book store) ---
# Populated automatically by `vercel env pull` for a linked project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
