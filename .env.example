# Every env var the app reads MUST appear here.
# When you add or remove an env var in code, update this file in the same PR.
# Values here are placeholders — never commit real secrets.

# --- Runtime ---
NODE_ENV=development

# --- Anthropic (book brief generation) ---
ANTHROPIC_API_KEY=

# --- Upstash Redis (brief + book store; formerly Vercel KV — ADR-0008) ---
# Optional (ADR-0007): leave blank to run read-only on data/seeds.json — browsing
# works and generation returns a brief, but nothing persists and rate limits are off.
# Set both URL and TOKEN to enable persistence, dedup, and rate limiting.
# Populated automatically by `vercel env pull` for a linked project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=

# --- Abuse controls (per-IP throttle + global daily spend cap) ---
# Positive integers; both fall back to the defaults shown when unset (spec 0005 / ADR-0003).
RATE_LIMIT_IP_PER_DAY=20
RATE_LIMIT_GLOBAL_PER_DAY=100
